{
  "name": "filebud",
  "version": "0.1.0",
  "description": "Browse a folder or archive as a file tree in your browser",
  "keywords": [
    "cli",
    "file-browser",
    "file-tree",
    "viewer",
    "zip",
    "tar"
  ],
  "homepage": "https://github.com/ernilambar/filebud#readme",
  "bugs": {
    "url": "https://github.com/ernilambar/filebud/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernilambar/filebud.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "filebud": "./bin/filebud.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "build": "rollup -c",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "npm run build",
    "start": "node bin/filebud.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@codemirror/language-data": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@fastify/static": "10.1.3",
    "@xhmikosr/decompress": "11.1.4",
    "cac": "7.0.0",
    "codemirror": "6.0.2",
    "fastify": "5.12.1",
    "open": "11.0.1",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "eslint": "^9.39.5",
    "neostandard": "0.13.0",
    "rollup": "4.62.5"
  },
  "engines": {
    "node": ">=22"
  }
}
